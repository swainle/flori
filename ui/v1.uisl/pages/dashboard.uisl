style.page.title: 数据大屏
style.page.platform: MobileWeb
style.page.background: token.colors.pageBackground
style.page.padding: token.spacing.md
style.page.bottomSafeArea: true

style.topAppBarDashboard.position: StickyTop
style.topAppBarDashboard.height: 64
style.topAppBarDashboard.background: token.colors.surface
style.topAppBarDashboard.borderBottom: token.colors.border
style.topAppBarDashboard.children["avatarUser"].shape: Circle
style.topAppBarDashboard.children["avatarUser"].size: 40
style.topAppBarDashboard.children["avatarUser"].alt: 专业商务头像
style.topAppBarDashboard.children["title"].text: 数据大屏
style.topAppBarDashboard.children["title"].render: Text
style.topAppBarDashboard.children["title"].variant: HeadlineMobile
style.topAppBarDashboard.actions["notifications"].icon: Notifications
style.topAppBarDashboard.actions["notifications"].variant: Icon
style.topAppBarDashboard.actions["notifications"].ariaLabel: 通知

style.metricGridDashboard.layout: Grid
style.metricGridDashboard.columns.mobile: 2
style.metricGridDashboard.gap: token.spacing.md
style.metricGridDashboard.children["metricRevenue"].label: 今日营收
style.metricGridDashboard.children["metricRevenue"].value: ¥42,850
style.metricGridDashboard.children["metricRevenue"].trendLabel: +12%
style.metricGridDashboard.children["metricRevenue"].trendDirection: Up
style.metricGridDashboard.children["metricRevenue"].trendColor: Success
style.metricGridDashboard.children["metricRevenue"].render: Currency
style.metricGridDashboard.children["metricRevenue"].sparkline: M0,25 Q15,5 30,20 T60,10 T90,25 T100,15
style.metricGridDashboard.children["metricActiveUsers"].label: 活跃用户
style.metricGridDashboard.children["metricActiveUsers"].value: 1,284
style.metricGridDashboard.children["metricActiveUsers"].trendLabel: +8%
style.metricGridDashboard.children["metricActiveUsers"].trendDirection: Up
style.metricGridDashboard.children["metricActiveUsers"].trendColor: Success
style.metricGridDashboard.children["metricActiveUsers"].render: Number
style.metricGridDashboard.children["metricActiveUsers"].sparkline: M0,15 Q20,25 40,15 T70,20 T100,5
style.metricGridDashboard.children["metricConversionRate"].label: 转化率
style.metricGridDashboard.children["metricConversionRate"].value: 3.42%
style.metricGridDashboard.children["metricConversionRate"].trendLabel: -2%
style.metricGridDashboard.children["metricConversionRate"].trendDirection: Down
style.metricGridDashboard.children["metricConversionRate"].trendColor: Danger
style.metricGridDashboard.children["metricConversionRate"].render: Percent
style.metricGridDashboard.children["metricConversionRate"].sparkline: M0,5 Q20,10 40,25 T70,15 T100,20
style.metricGridDashboard.children["metricTodo"].label: 待办事项
style.metricGridDashboard.children["metricTodo"].value: 12
style.metricGridDashboard.children["metricTodo"].statusLabel: 进行中
style.metricGridDashboard.children["metricTodo"].statusColor: Primary
style.metricGridDashboard.children["metricTodo"].render: Number
style.metricGridDashboard.children["metricTodo"].sparkline: M0,20 L20,15 L40,22 L60,10 L80,18 L100,5

style.chartBusinessGrowth.card: true
style.chartBusinessGrowth.title: 业务增长趋势
style.chartBusinessGrowth.actions["timeRange"].label: 最近7天
style.chartBusinessGrowth.actions["timeRange"].icon: ExpandMore
style.chartBusinessGrowth.children["areaChart"].render: Area
style.chartBusinessGrowth.children["areaChart"].lineColor: Primary
style.chartBusinessGrowth.children["areaChart"].fillColor: PrimaryTranslucent
