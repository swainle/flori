state.metricGridDashboard.conversionRate.trendPercent: -2
state.metricGridDashboard.todoCount.value: 12
state.metricGridDashboard.todoCount.status: 进行中
state.chartBusinessGrowth.series["businessGrowth"].label: 业务增长
state.chartBusinessGrowth.series["businessGrowth"].points: 130,110,140,90,40,70,50,30,10
state.chartBusinessGrowth.xAxisLabels: 周一,周二,周三,周四,周五,周六,周日
state.alertListRealtime.items["alertStock"].severity: error
state.alertListRealtime.items["alertStock"].title: 库存预警: 核心组件
state.alertListRealtime.items["alertStock"].description: SKU-2930 当前库存低于安全水平 (15/100)。
state.alertListRealtime.items["alertStock"].time: 10:24
